+std::string enum_value_prefix(const std::string &enum_name) {
+  std::string prefix;
+  prefix.reserve(enum_name.size() + 1);
+  for (size_t i = 0; i < enum_name.size(); ++i) {
+    const char current = enum_name[i];
+    const bool current_upper = current >= 'A' && current <= 'Z';
+    const bool previous_lower_or_digit =
+        i > 0 && ((enum_name[i - 1] >= 'a' && enum_name[i - 1] <= 'z') ||
+                  (enum_name[i - 1] >= '0' && enum_name[i - 1] <= '9'));
+    const bool next_lower = i + 1 < enum_name.size() &&
+                            enum_name[i + 1] >= 'a' &&
+                            enum_name[i + 1] <= 'z';
+    if (i > 0 && current_upper &&
+        (previous_lower_or_digit ||
+         (enum_name[i - 1] >= 'A' && enum_name[i - 1] <= 'Z' &&
+          next_lower))) {
+      prefix.push_back('_');
+    }
+    prefix.push_back(current >= 'a' && current <= 'z'
+                         ? static_cast<char>(current - 'a' + 'A')
+                         : current);
+  }
+  prefix.push_back('_');
+  return prefix;
+}
+
+bool can_strip_enum_value_prefix(const struct_enum &enum_inst,
+                                 const std::string &prefix) {
+  if (enum_inst.fields_.empty()) {
+    return false;
+  }
+  for (const auto &field : enum_inst.fields_) {
+    if (field.first.size() <= prefix.size() ||
+        field.first.compare(0, prefix.size(), prefix) != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::string google_enum_value_name(const std::string &name) {
+  std::string result = "k";
+  bool capitalize = true;
+  for (const char current : name) {
+    if (current == '_') {
+      capitalize = true;
+      continue;
+    }
+    if (current >= 'A' && current <= 'Z') {
+      result.push_back(capitalize
+                           ? current
+                           : static_cast<char>(current - 'A' + 'a'));
+    }
+    else if (current >= 'a' && current <= 'z') {
+      result.push_back(capitalize
+                           ? static_cast<char>(current - 'a' + 'A')
+                           : current);
+    }
+    else {
+      result.push_back(current);
+    }
+    capitalize = false;
+  }
+  return result;
+}
