function(ysm_import pkg_name)
    find_package("${pkg_name}" CONFIG REQUIRED)

    foreach(required_target IN ITEMS ${ARGN})
        if(NOT TARGET "${required_target}")
            message(FATAL_ERROR "Conan dependency target is missing: ${required_target} from package ${pkg_name}")
        endif()
    endforeach()
endfunction()

