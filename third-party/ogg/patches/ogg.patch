diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9776109..933f045 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -94,6 +94,8 @@ target_include_directories(ogg PUBLIC
     $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
 )
 
+target_compile_definitions(ogg PRIVATE YSM_OGG_USE_MIMALLOC=1)
+
 set_target_properties(
     ogg PROPERTIES
     SOVERSION ${LIB_SOVERSION}
diff --git a/include/ogg/os_types.h b/include/ogg/os_types.h
index e655a1d..e7bc934 100644
--- a/include/ogg/os_types.h
+++ b/include/ogg/os_types.h
@@ -18,10 +18,18 @@
 
 /* make it easy on the folks that want to compile the libs with a
    different malloc than stdlib */
+#if defined(YSM_OGG_USE_MIMALLOC)
+#include <mimalloc.h>
+#define _ogg_malloc  mi_malloc
+#define _ogg_calloc  mi_calloc
+#define _ogg_realloc mi_realloc
+#define _ogg_free    mi_free
+#else
 #define _ogg_malloc  malloc
 #define _ogg_calloc  calloc
 #define _ogg_realloc realloc
 #define _ogg_free    free
+#endif
 
 #if defined(_WIN32)
 
