+set(DAV1D_C_COMPILE_OPTIONS "")
+function(dav1d_add_c_flag_if_supported flag)
+    string(MAKE_C_IDENTIFIER "${flag}" _flag_var)
+    check_c_compiler_flag("${flag}" "DAV1D_HAS_C_FLAG_${_flag_var}")
+    if(DAV1D_HAS_C_FLAG_${_flag_var})
+        list(APPEND DAV1D_C_COMPILE_OPTIONS "$<$<COMPILE_LANGUAGE:C>:${flag}>")
+        set(DAV1D_C_COMPILE_OPTIONS "${DAV1D_C_COMPILE_OPTIONS}" PARENT_SCOPE)
+    endif()
+endfunction()
+
+if(MSVC)
+    list(APPEND DAV1D_C_COMPILE_OPTIONS
+        "$<$<COMPILE_LANGUAGE:C>:/wd4028>"
+        "$<$<COMPILE_LANGUAGE:C>:/wd4090>"
+        "$<$<COMPILE_LANGUAGE:C>:/wd4996>"
+    )
+else()
+    dav1d_add_c_flag_if_supported("-fvisibility=hidden")
+    dav1d_add_c_flag_if_supported("-Wundef")
+    dav1d_add_c_flag_if_supported("-Werror=vla")
+    dav1d_add_c_flag_if_supported("-Wno-maybe-uninitialized")
+    dav1d_add_c_flag_if_supported("-Wno-missing-field-initializers")
+    dav1d_add_c_flag_if_supported("-Wno-unused-parameter")
+    dav1d_add_c_flag_if_supported("-Wstrict-prototypes")
+    dav1d_add_c_flag_if_supported("-Werror=missing-prototypes")
+    dav1d_add_c_flag_if_supported("-Wshorten-64-to-32")
+    if(DAV1D_ARCH_ARM OR DAV1D_ARCH_AARCH64)
+        dav1d_add_c_flag_if_supported("-fno-align-functions")
+    endif()
+    if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
+        dav1d_add_c_flag_if_supported("-fomit-frame-pointer")
+        dav1d_add_c_flag_if_supported("-ffast-math")
+    endif()
+endif()
