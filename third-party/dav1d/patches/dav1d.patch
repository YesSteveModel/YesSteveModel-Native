diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..574e7c4
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,624 @@
+cmake_minimum_required(VERSION 3.20)
+
+project(dav1d
+    VERSION 1.5.4
+    LANGUAGES C
+)
+
+include(CheckCCompilerFlag)
+include(CheckCSourceCompiles)
+include(CheckFunctionExists)
+include(CheckIncludeFile)
+include(CheckSymbolExists)
+include(TestBigEndian)
+
+option(DAV1D_ENABLE_ASM "Build architecture-specific assembly optimizations" ON)
+option(DAV1D_LOGGING "Enable dav1d log callbacks" OFF)
+option(DAV1D_MACOS_KPERF "Use the private macOS kperf API for benchmarking" OFF)
+set(DAV1D_BITDEPTHS "8;16" CACHE STRING "Enabled bitdepths. Valid values: 8;16")
+set(DAV1D_TRIM_DSP "if-release" CACHE STRING "Trim redundant DSP functions: true, false, if-release")
+set_property(CACHE DAV1D_TRIM_DSP PROPERTY STRINGS true false if-release)
+
+foreach(_bitdepth IN LISTS DAV1D_BITDEPTHS)
+    if(NOT _bitdepth STREQUAL "8" AND NOT _bitdepth STREQUAL "16")
+        message(FATAL_ERROR "DAV1D_BITDEPTHS only supports 8 and 16, got '${_bitdepth}'")
+    endif()
+endforeach()
+if(DAV1D_BITDEPTHS STREQUAL "")
+    message(FATAL_ERROR "DAV1D_BITDEPTHS must enable at least one bitdepth")
+endif()
+if(NOT DAV1D_TRIM_DSP MATCHES "^(true|false|if-release)$")
+    message(FATAL_ERROR "DAV1D_TRIM_DSP must be one of: true, false, if-release")
+endif()
+
+set(CMAKE_C_STANDARD 99)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+set(CMAKE_C_EXTENSIONS ON)
+
+string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" DAV1D_SYSTEM_PROCESSOR)
+set(DAV1D_ARCH_X86 FALSE)
+set(DAV1D_ARCH_X86_64 FALSE)
+set(DAV1D_ARCH_X86_32 FALSE)
+set(DAV1D_ARCH_AARCH64 FALSE)
+set(DAV1D_ARCH_ARM FALSE)
+if(DAV1D_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|x64)$")
+    set(DAV1D_ARCH_X86 TRUE)
+    set(DAV1D_ARCH_X86_64 TRUE)
+elseif(DAV1D_SYSTEM_PROCESSOR MATCHES "^(i[3-6]86|x86)$")
+    set(DAV1D_ARCH_X86 TRUE)
+    set(DAV1D_ARCH_X86_32 TRUE)
+elseif(DAV1D_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
+    set(DAV1D_ARCH_AARCH64 TRUE)
+elseif(DAV1D_SYSTEM_PROCESSOR MATCHES "^arm")
+    set(DAV1D_ARCH_ARM TRUE)
+endif()
+
+set(DAV1D_USE_X86_ASM FALSE)
+set(DAV1D_USE_ARM64_ASM FALSE)
+if(DAV1D_ENABLE_ASM)
+    if(DAV1D_ARCH_X86_64)
+        set(DAV1D_USE_X86_ASM TRUE)
+    elseif(DAV1D_ARCH_AARCH64)
+        set(DAV1D_USE_ARM64_ASM TRUE)
+    endif()
+endif()
+
+if(DAV1D_USE_X86_ASM)
+    if(WIN32)
+        set(CMAKE_ASM_NASM_OBJECT_FORMAT win64 CACHE STRING "" FORCE)
+    elseif(APPLE)
+        set(CMAKE_ASM_NASM_OBJECT_FORMAT macho64 CACHE STRING "" FORCE)
+    else()
+        set(CMAKE_ASM_NASM_OBJECT_FORMAT elf64 CACHE STRING "" FORCE)
+    endif()
+    enable_language(ASM_NASM)
+endif()
+
+if(DAV1D_USE_ARM64_ASM)
+    enable_language(ASM)
+endif()
+
+find_package(Git QUIET)
+if(Git_FOUND)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_CURRENT_SOURCE_DIR}" describe --long --always
+        OUTPUT_VARIABLE VCS_TAG
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        ERROR_QUIET
+        RESULT_VARIABLE _git_describe_result
+    )
+endif()
+if(NOT _git_describe_result EQUAL 0 OR VCS_TAG STREQUAL "")
+    set(VCS_TAG "${PROJECT_VERSION}")
+endif()
+configure_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/include/vcs_version.h.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/vcs_version.h"
+    @ONLY
+)
+
+list(FIND DAV1D_BITDEPTHS "8" _dav1d_has_8bpc)
+list(FIND DAV1D_BITDEPTHS "16" _dav1d_has_16bpc)
+set(DAV1D_HAVE_8BPC FALSE)
+set(DAV1D_HAVE_16BPC FALSE)
+if(NOT _dav1d_has_8bpc EQUAL -1)
+    set(DAV1D_HAVE_8BPC TRUE)
+endif()
+if(NOT _dav1d_has_16bpc EQUAL -1)
+    set(DAV1D_HAVE_16BPC TRUE)
+endif()
+
+if(DAV1D_TRIM_DSP STREQUAL "true")
+    set(DAV1D_TRIM_DSP_FUNCTIONS TRUE)
+elseif(DAV1D_TRIM_DSP STREQUAL "if-release")
+    if(NOT CMAKE_BUILD_TYPE OR CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
+        set(DAV1D_TRIM_DSP_FUNCTIONS TRUE)
+    else()
+        set(DAV1D_TRIM_DSP_FUNCTIONS FALSE)
+    endif()
+else()
+    set(DAV1D_TRIM_DSP_FUNCTIONS FALSE)
+endif()
+
+if(WIN32)
+    set(DAV1D_HAVE_CLOCK_GETTIME FALSE)
+    set(DAV1D_HAVE_POSIX_MEMALIGN FALSE)
+    set(DAV1D_HAVE_MEMALIGN FALSE)
+    set(DAV1D_HAVE_ALIGNED_ALLOC FALSE)
+    set(DAV1D_HAVE_DLSYM FALSE)
+    set(DAV1D_HAVE_GETAUXVAL FALSE)
+    set(DAV1D_HAVE_ELF_AUX_INFO FALSE)
+    set(DAV1D_HAVE_PTHREAD_NP_H FALSE)
+    set(DAV1D_HAVE_PTHREAD_GETAFFINITY_NP FALSE)
+    set(DAV1D_HAVE_PTHREAD_SETAFFINITY_NP FALSE)
+    set(DAV1D_HAVE_PTHREAD_SETNAME_NP FALSE)
+    set(DAV1D_HAVE_PTHREAD_SET_NAME_NP FALSE)
+    check_symbol_exists(fseeko "stdio.h" DAV1D_HAVE_FSEEKO)
+else()
+    if (NOT YSM_ANDROID)
+        find_package(Threads REQUIRED)
+        set(CMAKE_REQUIRED_LIBRARIES Threads::Threads)
+    endif ()
+    check_function_exists(clock_gettime DAV1D_HAVE_CLOCK_GETTIME)
+    check_function_exists(posix_memalign DAV1D_HAVE_POSIX_MEMALIGN)
+    check_function_exists(memalign DAV1D_HAVE_MEMALIGN)
+    check_function_exists(aligned_alloc DAV1D_HAVE_ALIGNED_ALLOC)
+    check_include_file(pthread_np.h DAV1D_HAVE_PTHREAD_NP_H)
+    check_symbol_exists(pthread_getaffinity_np "pthread.h" DAV1D_HAVE_PTHREAD_GETAFFINITY_NP)
+    check_symbol_exists(pthread_setaffinity_np "pthread.h" DAV1D_HAVE_PTHREAD_SETAFFINITY_NP)
+    check_symbol_exists(pthread_setname_np "pthread.h" DAV1D_HAVE_PTHREAD_SETNAME_NP)
+    check_symbol_exists(pthread_set_name_np "pthread.h" DAV1D_HAVE_PTHREAD_SET_NAME_NP)
+    set(CMAKE_REQUIRED_LIBRARIES)
+
+    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        check_symbol_exists(dlsym "dlfcn.h" DAV1D_HAVE_DLSYM)
+    else()
+        set(DAV1D_HAVE_DLSYM FALSE)
+    endif()
+
+    if(DAV1D_ARCH_AARCH64 OR DAV1D_ARCH_ARM)
+        check_symbol_exists(getauxval "sys/auxv.h" DAV1D_HAVE_GETAUXVAL)
+        check_symbol_exists(elf_aux_info "sys/auxv.h" DAV1D_HAVE_ELF_AUX_INFO)
+    else()
+        set(DAV1D_HAVE_GETAUXVAL FALSE)
+        set(DAV1D_HAVE_ELF_AUX_INFO FALSE)
+    endif()
+endif()
+
+check_include_file(stdatomic.h DAV1D_HAVE_STDATOMIC_H)
+set(DAV1D_STDATOMIC_INCLUDE_DIR "")
+if(NOT DAV1D_HAVE_STDATOMIC_H)
+    if(MSVC)
+        set(DAV1D_STDATOMIC_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/include/compat/msvc")
+    else()
+        check_c_source_compiles(
+            "int main(void) { int v = 0; return __atomic_fetch_add(&v, 1, __ATOMIC_SEQ_CST); }"
+            DAV1D_HAVE_GCC_ATOMICS
+        )
+        if(DAV1D_HAVE_GCC_ATOMICS)
+            set(DAV1D_STDATOMIC_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/include/compat/gcc")
+        else()
+            message(FATAL_ERROR "Atomics are not supported by this compiler")
+        endif()
+    endif()
+endif()
+
+check_include_file(sys/types.h DAV1D_HAVE_SYS_TYPES_H)
+check_include_file(unistd.h DAV1D_HAVE_UNISTD_H)
+check_include_file(io.h DAV1D_HAVE_IO_H)
+check_c_source_compiles("int x = _Generic(0, default: 0); int main(void) { return x; }" DAV1D_HAVE_C11_GENERIC)
+TEST_BIG_ENDIAN(DAV1D_ENDIANNESS_BIG)
+
+if(DAV1D_USE_ARM64_ASM)
+    check_c_source_compiles(
+        [=[
+        __asm__ (
+        ".func cmake_test\\n"
+        ".endfunc\\n"
+        );
+        int main(void) { return 0; }
+        ]=]
+        DAV1D_HAVE_AS_FUNC
+    )
+
+    check_c_source_compiles(
+        [=[
+        __asm__ (".arch armv8-a\\n");
+        int main(void) { return 0; }
+        ]=]
+        DAV1D_HAVE_AS_ARCH_DIRECTIVE
+    )
+
+    if(DAV1D_HAVE_AS_ARCH_DIRECTIVE)
+        set(DAV1D_AS_ARCH_LEVEL "armv8-a")
+        foreach(_arch_level IN ITEMS armv8.2-a armv8.4-a armv8.6-a)
+            string(REPLACE "." "_" _arch_var "${_arch_level}")
+            string(REPLACE "-" "_" _arch_var "${_arch_var}")
+            string(TOUPPER "${_arch_var}" _arch_var)
+            check_c_source_compiles(
+                "__asm__ (\".arch ${_arch_level}\\\\n\"); int main(void) { return 0; }"
+                "DAV1D_HAVE_AS_ARCH_${_arch_var}"
+            )
+            if(DAV1D_HAVE_AS_ARCH_${_arch_var})
+                set(DAV1D_AS_ARCH_LEVEL "${_arch_level}")
+            endif()
+        endforeach()
+
+        string(REPLACE "." "_" _arch_crc_var "${DAV1D_AS_ARCH_LEVEL}")
+        string(REPLACE "-" "_" _arch_crc_var "${_arch_crc_var}")
+        string(REPLACE "+" "_" _arch_crc_var "${_arch_crc_var}")
+        string(TOUPPER "${_arch_crc_var}" _arch_crc_var)
+        check_c_source_compiles(
+            "__asm__ (\".arch ${DAV1D_AS_ARCH_LEVEL}+crc\\\\n\"); int main(void) { return 0; }"
+            "DAV1D_HAVE_AS_ARCH_${_arch_crc_var}_CRC"
+        )
+        if(DAV1D_HAVE_AS_ARCH_${_arch_crc_var}_CRC)
+            set(DAV1D_AS_ARCH_LEVEL "${DAV1D_AS_ARCH_LEVEL}+crc")
+        endif()
+    endif()
+
+    function(dav1d_check_aarch64_extension name instruction)
+        string(TOUPPER "${name}" _upper_name)
+
+        set(_code "__asm__ (\n")
+        if(DAV1D_HAVE_AS_ARCH_DIRECTIVE)
+            string(APPEND _code "\".arch ${DAV1D_AS_ARCH_LEVEL}\\\\n\"\n")
+        endif()
+        string(APPEND _code "\".arch_extension ${name}\\\\n\"\n")
+        string(APPEND _code ");\nint main(void) { return 0; }\n")
+        check_c_source_compiles("${_code}" "DAV1D_HAVE_AS_ARCHEXT_${_upper_name}_DIRECTIVE")
+
+        set(_code "__asm__ (\n")
+        if(DAV1D_HAVE_AS_ARCH_DIRECTIVE)
+            string(APPEND _code "\".arch ${DAV1D_AS_ARCH_LEVEL}\\\\n\"\n")
+        endif()
+        if(DAV1D_HAVE_AS_ARCHEXT_${_upper_name}_DIRECTIVE)
+            string(APPEND _code "\".arch_extension ${name}\\\\n\"\n")
+        endif()
+        string(APPEND _code "\"${instruction}\\\\n\"\n")
+        string(APPEND _code ");\nint main(void) { return 0; }\n")
+        check_c_source_compiles("${_code}" "DAV1D_HAVE_${_upper_name}")
+
+        set("DAV1D_HAVE_AS_ARCHEXT_${_upper_name}_DIRECTIVE" "${DAV1D_HAVE_AS_ARCHEXT_${_upper_name}_DIRECTIVE}" PARENT_SCOPE)
+        set("DAV1D_HAVE_${_upper_name}" "${DAV1D_HAVE_${_upper_name}}" PARENT_SCOPE)
+    endfunction()
+
+    dav1d_check_aarch64_extension(dotprod "udot v0.4s, v0.16b, v0.16b")
+    dav1d_check_aarch64_extension(i8mm "usdot v0.4s, v0.16b, v0.16b")
+    dav1d_check_aarch64_extension(sve "whilelt p0.s, x0, x1")
+    dav1d_check_aarch64_extension(sve2 "sqrdmulh z0.s, z0.s, z0.s")
+endif()
+
+set(DAV1D_SYMBOL_PREFIX FALSE)
+if(APPLE OR (WIN32 AND DAV1D_ARCH_X86_32))
+    set(DAV1D_SYMBOL_PREFIX TRUE)
+endif()
+
+set(DAV1D_CONFIG_H "/* auto-generated by CMake, do not edit */\n")
+function(dav1d_config_bool name value)
+    if(${value})
+        string(APPEND DAV1D_CONFIG_H "#define ${name} 1\n")
+    else()
+        string(APPEND DAV1D_CONFIG_H "#define ${name} 0\n")
+    endif()
+    set(DAV1D_CONFIG_H "${DAV1D_CONFIG_H}" PARENT_SCOPE)
+endfunction()
+function(dav1d_config_define name value)
+    string(APPEND DAV1D_CONFIG_H "#define ${name} ${value}\n")
+    set(DAV1D_CONFIG_H "${DAV1D_CONFIG_H}" PARENT_SCOPE)
+endfunction()
+function(dav1d_config_define_if name condition value)
+    if(${condition})
+        string(APPEND DAV1D_CONFIG_H "#define ${name} ${value}\n")
+    endif()
+    set(DAV1D_CONFIG_H "${DAV1D_CONFIG_H}" PARENT_SCOPE)
+endfunction()
+
+dav1d_config_bool(CONFIG_8BPC DAV1D_HAVE_8BPC)
+dav1d_config_bool(CONFIG_16BPC DAV1D_HAVE_16BPC)
+dav1d_config_bool(HAVE_ASM DAV1D_ENABLE_ASM)
+dav1d_config_bool(TRIM_DSP_FUNCTIONS DAV1D_TRIM_DSP_FUNCTIONS)
+dav1d_config_bool(CONFIG_LOG DAV1D_LOGGING)
+dav1d_config_bool(CONFIG_MACOS_KPERF DAV1D_MACOS_KPERF)
+if(WIN32)
+    dav1d_config_define(UNICODE 1)
+    dav1d_config_define(_UNICODE 1)
+    dav1d_config_define(__USE_MINGW_ANSI_STDIO 1)
+    dav1d_config_define(_CRT_DECLARE_NONSTDC_NAMES 1)
+    if(NOT DAV1D_HAVE_FSEEKO)
+        dav1d_config_define(fseeko _fseeki64)
+        dav1d_config_define(ftello _ftelli64)
+    endif()
+endif()
+dav1d_config_bool(HAVE_CLOCK_GETTIME DAV1D_HAVE_CLOCK_GETTIME)
+dav1d_config_bool(HAVE_POSIX_MEMALIGN DAV1D_HAVE_POSIX_MEMALIGN)
+dav1d_config_bool(HAVE_MEMALIGN DAV1D_HAVE_MEMALIGN)
+dav1d_config_bool(HAVE_ALIGNED_ALLOC DAV1D_HAVE_ALIGNED_ALLOC)
+dav1d_config_bool(HAVE_DLSYM DAV1D_HAVE_DLSYM)
+dav1d_config_bool(HAVE_SYS_TYPES_H DAV1D_HAVE_SYS_TYPES_H)
+dav1d_config_bool(HAVE_UNISTD_H DAV1D_HAVE_UNISTD_H)
+dav1d_config_bool(HAVE_IO_H DAV1D_HAVE_IO_H)
+dav1d_config_bool(HAVE_PTHREAD_NP_H DAV1D_HAVE_PTHREAD_NP_H)
+dav1d_config_bool(HAVE_GETAUXVAL DAV1D_HAVE_GETAUXVAL)
+dav1d_config_bool(HAVE_ELF_AUX_INFO DAV1D_HAVE_ELF_AUX_INFO)
+dav1d_config_bool(HAVE_PTHREAD_GETAFFINITY_NP DAV1D_HAVE_PTHREAD_GETAFFINITY_NP)
+dav1d_config_bool(HAVE_PTHREAD_SETAFFINITY_NP DAV1D_HAVE_PTHREAD_SETAFFINITY_NP)
+dav1d_config_bool(HAVE_PTHREAD_SETNAME_NP DAV1D_HAVE_PTHREAD_SETNAME_NP)
+dav1d_config_bool(HAVE_PTHREAD_SET_NAME_NP DAV1D_HAVE_PTHREAD_SET_NAME_NP)
+dav1d_config_bool(HAVE_C11_GENERIC DAV1D_HAVE_C11_GENERIC)
+dav1d_config_bool(ENDIANNESS_BIG DAV1D_ENDIANNESS_BIG)
+dav1d_config_bool(ARCH_AARCH64 DAV1D_ARCH_AARCH64)
+dav1d_config_bool(ARCH_ARM DAV1D_ARCH_ARM)
+dav1d_config_bool(HAVE_AS_FUNC DAV1D_HAVE_AS_FUNC)
+dav1d_config_bool(HAVE_AS_ARCH_DIRECTIVE DAV1D_HAVE_AS_ARCH_DIRECTIVE)
+dav1d_config_define_if(AS_ARCH_LEVEL DAV1D_HAVE_AS_ARCH_DIRECTIVE "${DAV1D_AS_ARCH_LEVEL}")
+dav1d_config_bool(HAVE_AS_ARCHEXT_DOTPROD_DIRECTIVE DAV1D_HAVE_AS_ARCHEXT_DOTPROD_DIRECTIVE)
+dav1d_config_bool(HAVE_AS_ARCHEXT_I8MM_DIRECTIVE DAV1D_HAVE_AS_ARCHEXT_I8MM_DIRECTIVE)
+dav1d_config_bool(HAVE_AS_ARCHEXT_SVE_DIRECTIVE DAV1D_HAVE_AS_ARCHEXT_SVE_DIRECTIVE)
+dav1d_config_bool(HAVE_AS_ARCHEXT_SVE2_DIRECTIVE DAV1D_HAVE_AS_ARCHEXT_SVE2_DIRECTIVE)
+dav1d_config_bool(HAVE_DOTPROD DAV1D_HAVE_DOTPROD)
+dav1d_config_bool(HAVE_I8MM DAV1D_HAVE_I8MM)
+dav1d_config_bool(HAVE_SVE DAV1D_HAVE_SVE)
+dav1d_config_bool(HAVE_SVE2 DAV1D_HAVE_SVE2)
+dav1d_config_bool(ARCH_X86 DAV1D_ARCH_X86)
+dav1d_config_bool(ARCH_X86_64 DAV1D_ARCH_X86_64)
+dav1d_config_bool(ARCH_X86_32 DAV1D_ARCH_X86_32)
+dav1d_config_bool(ARCH_PPC64LE FALSE)
+dav1d_config_bool(ARCH_RISCV FALSE)
+dav1d_config_bool(ARCH_RV32 FALSE)
+dav1d_config_bool(ARCH_RV64 FALSE)
+dav1d_config_bool(ARCH_LOONGARCH FALSE)
+dav1d_config_bool(ARCH_LOONGARCH32 FALSE)
+dav1d_config_bool(ARCH_LOONGARCH64 FALSE)
+dav1d_config_define_if(PREFIX DAV1D_SYMBOL_PREFIX 1)
+
+file(CONFIGURE
+    OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/config.h"
+    CONTENT "${DAV1D_CONFIG_H}"
+    @ONLY
+    NEWLINE_STYLE UNIX
+)
+
+if(DAV1D_USE_X86_ASM)
+    set(DAV1D_CONFIG_ASM "; auto-generated by CMake, do not edit\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define private_prefix dav1d\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define STACK_ALIGNMENT 16\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define ARCH_X86_64 1\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define ARCH_X86_32 0\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define PIC 1\n")
+    string(APPEND DAV1D_CONFIG_ASM "%define FORCE_VEX_ENCODING 0\n")
